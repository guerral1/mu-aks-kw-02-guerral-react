{
  "name": "banksch-mu-aks-ui",
  "version": "1.0.0",
  "description": "Front-end UI of MU AKS",
  "author": "Manulife University - AKS Booster",
  "private": true,
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "react-scripts": "^5.0.1",
    "styled-components": "^6.1.13"
  },
  "overrides": {
    "nth-check": "2.1.1",
    "postcss": "8.4.47"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "docker:local:build": "docker build -t banksch-mu-aks-ui:local -f Dockerfile.local . --platform linux/amd64",
    "docker:local:run": "docker run -p 3000:3000 --platform linux/amd64 banksch-mu-aks-ui:local",
    "docker:local:buildprod": "docker build -t banksch-mu-aks-ui:1.0 -f Dockerfile . --platform linux/amd64",
    "docker:local:runprod": "docker run -dp 80:8080 -e API_URL=http://localhost:3001/api --platform linux/amd64 banksch-mu-aks-ui:1.0"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}

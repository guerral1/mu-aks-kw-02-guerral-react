{
  "name": "coach-mu-aks-react",
  "version": "1.0.0",
  "description": "Front-end UI of MU AKS",
  "author": "Manulife University - AKS Booster",
  "private": true,
  "dependencies": {
    "@awesomecomponents/mux": "^2.1.38",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-router-dom": "^5.2.0",
    "react-scripts": "4.0.1",
    "styled-components": "^5.2.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "docker:build:local": "docker build . -t coach-mu-aks-react",
    "docker:run:local": "docker run -p 3000:3000 coach-mu-aks-react",
    "docker:build:k8s": "docker build . -t coach-mu-aks-react:1.0 -f Dockerfile.prod",
    "docker:run:k8s": "docker run -p 80:80 -e API_URL=saywhaaat coach-mu-aks-react:1.0",
    "docker:build:acr": "docker build . -t muaksacr.azurecr.io/coach-mu-aks-react:latest -f Dockerfile.prod"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}